# Copy to terraform.tfvars and fill in. NEVER commit terraform.tfvars.
#
# iac-user access key (policies: AmazonEC2FullAccess, IAMFullAccess, AmazonSSMReadOnlyAccess)
aws_access_key_id     = "AKIA..."
aws_secret_access_key = "..."

# GitHub PAT used by the runner to mint registration tokens at boot.
# Fine-grained: repo-scoped, "Administration: Read and write".  Classic: "repo" scope.
github_pat = "github_pat_11..."

# Optional — defaults shown
# aws_region   = "ca-central-1"
# env_prefix   = "dev"
# github_owner = "OkomaNdu"
# github_repo  = "juice-shop-devsecops-pipelin"
